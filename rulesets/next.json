            "integration_id": 15368
          },
          {
            "context": "classification / pr-title",
            "integration_id": 15368
          },
          {
            "context": "gate / external-contribution-gate",
            "integration_id": 15368
          },
          {
            "context": "review / claude-review",
            "integration_id": 15368
          },
          {
            "context": "docs / docs-required",
            "integration_id": 15368
          },
          {
            "context": "wip / wip-limit",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
